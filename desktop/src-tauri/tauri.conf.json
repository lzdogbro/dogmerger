{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dogmerger",
  "version": "0.2.0",
  "identifier": "com.lzdogbro.dogmerger",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dogmerger",
        "width": 1240,
        "height": 980,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "THIRD-PARTY.md",
      "licenses/COPYING.LGPLv2.1"
    ]
  }
}
